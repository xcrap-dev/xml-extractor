{
  "name": "@xcrap/xml-extractor",
  "version": "0.1.0",
  "description": "Xcrap XML Extractor is a package of the Xcrap framework, it was developed to take care of the data extraction part of XML documents using XPath and declarative models, integrating with @xcrap/extractor.",
  "keywords": [
    "xcrap",
    "xml",
    "xml-extractor",
    "extractor",
    "parser",
    "xpath",
    "web scraping",
    "scrapy"
  ],
  "homepage": "https://github.com/xcrap-dev/xml-extractor#readme",
  "bugs": {
    "url": "https://github.com/xcrap-dev/xml-extractor/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xcrap-dev/xml-extractor.git"
  },
  "license": "MIT",
  "author": "Marcuth",
  "type": "commonjs",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*",
    "!/**/__tests__"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx ./src/index.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "test": "vitest",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "xpath": "^0.0.36"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@xcrap/extractor": "^0.3.2",
    "oxlint": "^1.93.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@xcrap/extractor": "^0.3.2"
  }
}
